# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# Instagram / Meta App
# این پروژه از Instagram API with Instagram Login استفاده می‌کند.
# نه Facebook Login و نه Basic Display.

NEXT_PUBLIC_INSTAGRAM_APP_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

META_APP_SECRET=

# آدرس برگشت OAuth اینستاگرام
NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# توکن تایید Webhook
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=


# AI Auto Reply
GROQ_API_KEY=
# OPENAI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=


